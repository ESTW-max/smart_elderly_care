APP_NAME=MiniApp API
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
JWT_SECRET=replace-this-in-production

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# Agent
AGENT_SYSTEM_PROMPT=You are a helpful coding agent.
AGENT_WORKSPACE=.
AGENT_TEST_ENDPOINT_ENABLED=false
AGENT_MAX_STEPS=100
AGENT_MAX_TOKENS=100000
AGENT_MAX_SECONDS=3600
AGENT_CONTEXT_MAX_TOKENS=16000
AGENT_MESSAGE_MAX_TOKENS=8000
AGENT_TOOL_OUTPUT_MAX_TOKENS=6000
AGENT_STATE_DATABASE_PATH=./data/agent-state.db
AGENT_ALLOWED_COMMANDS=pwd,ls,find,grep,git,python,pytest,ruff
AGENT_FILE_READ_ENABLED=true
AGENT_FILE_WRITE_ENABLED=false
AGENT_APPROVAL_REQUIRED_RISK=high
AGENT_MAX_OUTPUT_CHARS=8000
AGENT_MAX_CPU_SECONDS=
AGENT_MAX_FILE_SIZE_BYTES=10000000
AGENT_BLOCKED_ENV_PREFIXES=DEEPSEEK_,OPENAI_,ANTHROPIC_
